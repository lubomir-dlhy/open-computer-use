{
  "manifest_version": 3,
  "name": "Open Computer Use Browser",
  "description": "Lets Open Computer Use drive Chrome tabs in the background.",
  "version": "1.3.0",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self';"
  },
  "host_permissions": ["<all_urls>"],
  "permissions": ["alarms", "background", "debugger", "downloads", "nativeMessaging", "scripting", "storage", "tabGroups", "tabs"]
}
